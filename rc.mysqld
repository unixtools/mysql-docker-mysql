#!/bin/bash -x
cd /local/mysql

docker update --restart no mysql
/local/mysql/sbin/wrap-exec mysqladmin shutdown
docker stop mysql
docker rm mysql

# Clean any pid file
if [ -e /local/mysql/cluster ]; then
    rm -f /local/mysql/data/wsrep_sst.pid
fi

ARGS=""
if [ -e /local/mysql/bootstrap -a -e /local/mysql/cluster ]; then
	ARGS="$ARGS --wsrep_cluster_address=gcomm://"
fi

if [ ! -e /local/mysql/mysql.conf ]; then
    cp /local/mysql/defaults.conf /local/mysql/mysql.conf
fi

/local/mysql/sbin/wrap-detach \
    mysqld \
	--defaults-extra-file=/local/mysql/mysql.conf \
	--datadir=/local/mysql/data \
	--explicit_defaults_for_timestamp \
	$ARGS

# add something here to wait until mysql is running up to a limit?

if [ -e /local/mysql/bootstrap -a -e /local/mysql/cluster ]; then
	rm -f /local/mysql/bootstrap
fi

